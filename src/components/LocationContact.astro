---
// LocationContact.astro
import { Image } from 'astro:assets';
import frontDeskImg from '../assets/images/front-desk.avif';

const hours = [
  { day: "Tuesday", time: "8:00 AM – 5:00 PM" },
  { day: "Wednesday", time: "8:00 AM – 5:00 PM" },
  { day: "Thursday", time: "8:00 AM – 5:00 PM" },
  { day: "Friday", time: "8:00 AM – 5:00 PM" },
  { day: "Saturday", time: "8:00 AM – 5:00 PM" },
  { day: "Sunday – Monday", time: "Closed (Emergency On-Call)" }
];
---

<section class="location-section section" id="location">
  <div class="container">
    <div class="section-header">
      <span class="badge badge-primary">Visit Our Office</span>
      <h2 class="section-title">
        Conveniently Located in <span class="text-gradient">Burbank, CA</span>
      </h2>
      <p class="section-subtitle">
        Located on West Burbank Boulevard with dedicated parking and easy access from the 5 Freeway, Downtown Burbank, and the Media District.
      </p>
    </div>

    <div class="location-grid">
      <!-- Left Contact & Hours Card -->
      <div class="location-card">
        <h3 class="card-heading">Practice Information</h3>

        <div class="info-group">
          <div class="info-icon">📍</div>
          <div>
            <h3 class="info-title">Office Address</h3>
            <p class="info-val">916 W Burbank Blvd. Suite A<br />Burbank, CA 91506</p>
            <a 
              href="https://www.google.com/maps/place/BB+Dental+Care/@34.1836136,-118.3249744,17z/data=!3m2!4b1!5s0x80c2954286a52623:0x45a53f0c1f8617ae!4m6!3m5!1s0x80c2957b30c8b875:0xf98e3d9c56de1624!8m2!3d34.1836092!4d-118.3223941!16s%2Fg%2F11s99c1zml?entry=ttu" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="map-link"
            >
              Get Google Maps Directions ↗
            </a>
          </div>
        </div>

        <div class="info-group">
          <div class="info-icon">📞</div>
          <div>
            <h3 class="info-title">Call or Text</h3>
            <a href="tel:8182563060" class="phone-highlight">(818) 256-3060</a>
            <p class="info-sub">Speak with our patient care coordinators</p>
          </div>
        </div>

        <div class="info-group">
          <div class="info-icon">✉️</div>
          <div>
            <h3 class="info-title">Email Us</h3>
            <a href="mailto:info@bbdentalcare.com" class="email-link">info@bbdentalcare.com</a>
          </div>
        </div>

        <div class="hours-block">
          <h3 class="hours-title">Office Hours</h3>
          <div class="hours-table">
            {hours.map((h) => (
              <div class="hours-row">
                <span class="day-label">{h.day}</span>
                <span class="time-label">{h.time}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="location-btn-wrap">
          <a href="https://appointments.bbdentalcare.com" target="_blank" rel="noopener noreferrer" class="btn btn-primary w-full">
            Book an Appointment Online
          </a>
        </div>
      </div>

      <!-- Right Office Visual / Map Preview Card -->
      <div class="visual-card">
        <div class="front-desk-image-wrap">
          <Image 
            src={frontDeskImg} 
            alt="BB Dental Care Front Desk Burbank" 
            width={600} 
            height={400} 
            class="front-desk-img"
          />
          <div class="image-overlay-card">
            <h3>Modern & Welcoming Reception</h3>
            <p>Step inside our calming, boutique Burbank dental sanctuary.</p>
          </div>
        </div>

        <div class="map-embed-card">
          <div class="map-header">
            <div>
              <strong>BB Dental Care</strong>
              <p>916 W Burbank Blvd. Suite A, Burbank, CA</p>
            </div>
            <a 
              href="https://www.google.com/maps/place/BB+Dental+Care/@34.1836136,-118.3249744,17z/data=!3m2!4b1!5s0x80c2954286a52623:0x45a53f0c1f8617ae!4m6!3m5!1s0x80c2957b30c8b875:0xf98e3d9c56de1624!8m2!3d34.1836092!4d-118.3223941!16s%2Fg%2F11s99c1zml?entry=ttu" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="btn btn-dark btn-sm"
            >
              Open in Maps
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .location-section {
    background: #ffffff;
    border-top: 1px solid var(--brand-border);
  }

  .section-header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 3.5rem;
  }

  .section-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 800;
    color: var(--brand-main);
    margin: 0.85rem 0 1rem;
    line-height: 1.2;
  }

  .section-subtitle {
    font-size: 1.1rem;
    color: var(--brand-secondary);
    line-height: 1.6;
  }

  .location-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
  }

  .location-card {
    background: var(--brand-bg);
    border: 1px solid var(--brand-border);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
  }

  .card-heading {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--brand-main);
    margin-bottom: 2rem;
  }

  .info-group {
    display: flex;
    gap: 1.25rem;
    margin-bottom: 1.75rem;
  }

  .info-icon {
    font-size: 1.5rem;
    line-height: 1;
  }

  .info-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--brand-main);
    margin-bottom: 0.25rem;
  }

  .info-val {
    font-size: 0.95rem;
    color: var(--brand-secondary);
    line-height: 1.5;
    margin-bottom: 0.45rem;
  }

  .map-link {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--brand-primary);
    text-decoration: underline;
  }

  .phone-highlight {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--brand-primary);
    display: block;
    line-height: 1.2;
  }

  .info-sub {
    font-size: 0.825rem;
    color: var(--brand-muted);
  }

  .email-link {
    font-size: 0.95rem;
    color: var(--brand-primary);
    font-weight: 600;
  }

  .hours-block {
    background: #ffffff;
    border: 1px solid var(--brand-border);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    margin-top: 2rem;
    margin-bottom: 2rem;
  }

  .hours-title {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--brand-main);
    margin-bottom: 1rem;
  }

  .hours-table {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .hours-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.9rem;
  }

  .day-label {
    font-weight: 600;
    color: var(--brand-main);
  }

  .time-label {
    color: var(--brand-secondary);
  }

  .location-btn-wrap .w-full {
    width: 100%;
  }

  /* Right Visual Column */
  .visual-card {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .front-desk-image-wrap {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--brand-border);
    box-shadow: var(--shadow-sm);
  }

  .front-desk-img {
    width: 100%;
    height: 340px;
    object-fit: cover;
  }

  .image-overlay-card {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(0deg, rgba(15, 28, 28, 0.9) 0%, rgba(15, 28, 28, 0) 100%);
    color: #ffffff;
    padding: 2rem 1.5rem 1.25rem;
  }

  .image-overlay-card h4 {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  .image-overlay-card p {
    font-size: 0.85rem;
    color: var(--brand-accent-soft);
  }

  .map-embed-card {
    background: var(--brand-bg);
    border: 1px solid var(--brand-border);
    border-radius: var(--radius-lg);
    padding: 1.75rem 2rem;
  }

  .map-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .map-header strong {
    font-size: 1.1rem;
    color: var(--brand-main);
    display: block;
  }

  .map-header p {
    font-size: 0.875rem;
    color: var(--brand-muted);
  }

  @media (max-width: 992px) {
    .location-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
