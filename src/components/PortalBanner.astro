---
// PortalBanner.astro
import { Image } from 'astro:assets';
import bSymbolSvg from '../assets/images/b-symbol.svg';
import dentalCareSvg from '../assets/images/dental-care.svg';
import bookOnlineSvg from '../assets/images/book-online.svg';
import beautyCareSvg from '../assets/images/beauty-care.svg';
---

<section class="portal-section" id="portal">
  <div class="container">
    <div class="portal-intro">
      <div class="portal-tag">
        <Image src={bSymbolSvg} alt="BB Dental Care" width={20} height={20} />
        <span>Official Burbank Gateway</span>
      </div>
      <h2 class="portal-heading">
        Direct Access to <span class="text-gradient">BB Dental Care</span>
      </h2>
      <p class="portal-subheading">
        Welcome to <strong>burbank.dental</strong>. Choose an option below for fast online booking, exclusive new patient promotions, or to explore our complete Burbank practice website.
      </p>
    </div>

    <div class="portal-cards-grid">
      <!-- Card 1: Cleaning Offer -->
      <a href="https://bbdentalcare.com/cleaning-offer/" target="_blank" rel="noopener noreferrer" class="portal-card promo-card">
        <div class="portal-badge">Limited Time Offer</div>
        <div class="portal-icon-box">
          <Image src={dentalCareSvg} alt="Cleaning Offer" width={40} height={40} />
        </div>
        <h3 class="portal-card-title">New Patient Cleaning Offer</h3>
        <p class="portal-card-desc">
          Comprehensive dental exam, full digital X-rays, and professional dental cleaning for new patients.
        </p>
        <span class="portal-card-link">
          <span>Claim Cleaning Offer</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </span>
      </a>

      <!-- Card 2: Emergency Exam Offer -->
      <a href="https://bbdentalcare.com/emergency-exam-offer/" target="_blank" rel="noopener noreferrer" class="portal-card promo-card highlight-border">
        <div class="portal-badge emergency-badge">Same-Day Relief</div>
        <div class="portal-icon-box emergency-icon">
          <span class="icon-emoji">⚡</span>
        </div>
        <h3 class="portal-card-title">Emergency Dental Exam</h3>
        <p class="portal-card-desc">
          Experiencing tooth pain or an urgent dental issue? Get an immediate emergency evaluation and X-rays fast.
        </p>
        <span class="portal-card-link emergency-link">
          <span>Claim Emergency Offer</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </span>
      </a>

      <!-- Card 3: Online Scheduling -->
      <a href="https://appointments.bbdentalcare.com" target="_blank" rel="noopener noreferrer" class="portal-card booking-card">
        <div class="portal-badge book-badge">Fast & Easy</div>
        <div class="portal-icon-box">
          <Image src={bookOnlineSvg} alt="Book Online" width={40} height={40} />
        </div>
        <h3 class="portal-card-title">Book Online 24/7</h3>
        <p class="portal-card-desc">
          Select your preferred time slot and doctor instantly through our secure live appointment portal.
        </p>
        <span class="portal-card-link">
          <span>Open Booking Calendar</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </span>
      </a>

      <!-- Card 4: Official Main Website -->
      <a href="https://bbdentalcare.com" target="_blank" rel="noopener noreferrer" class="portal-card main-site-card">
        <div class="portal-badge main-badge">Full Experience</div>
        <div class="portal-icon-box">
          <Image src={beautyCareSvg} alt="BB Dental Care Services" width={40} height={40} />
        </div>
        <h3 class="portal-card-title">Visit bbdentalcare.com</h3>
        <p class="portal-card-desc">
          Explore all treatments, meet our full clinical team, read our blog, and review insurance coverage.
        </p>
        <span class="portal-card-link">
          <span>Go to Main Website</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  .portal-section {
    padding: 4.5rem 0;
    background-color: var(--brand-bg-white);
    border-top: 1px solid var(--brand-border);
    border-bottom: 1px solid var(--brand-border);
  }

  .portal-intro {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 3rem;
  }

  .portal-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--brand-primary-light);
    color: var(--brand-primary);
    padding: 0.35rem 0.95rem;
    border-radius: var(--radius-full);
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 1rem;
    border: 1px solid var(--brand-accent-soft);
  }

  .portal-heading {
    font-size: clamp(1.85rem, 3.2vw, 2.6rem);
    font-weight: 800;
    line-height: 1.2;
    color: var(--brand-main);
    margin-bottom: 0.85rem;
  }

  .portal-subheading {
    font-size: 1.05rem;
    color: var(--brand-secondary);
    line-height: 1.6;
  }

  .portal-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
  }

  .portal-card {
    background: var(--brand-bg);
    border: 1.5px solid var(--brand-border);
    border-radius: var(--radius-lg);
    padding: 2rem 1.65rem;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .portal-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-hover);
    border-color: var(--brand-primary);
    background: #ffffff;
  }

  .highlight-border {
    border-color: #ffd27d;
  }

  .highlight-border:hover {
    border-color: var(--brand-gold);
  }

  .portal-badge {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    font-size: 0.725rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
    background: var(--brand-primary-light);
    color: var(--brand-primary);
  }

  .emergency-badge {
    background: #ffebe6;
    color: #c93b2b;
  }

  .book-badge {
    background: #e6f7ff;
    color: #0077b6;
  }

  .main-badge {
    background: #f0ebf8;
    color: #5d3ebc;
  }

  .portal-icon-box {
    width: 56px;
    height: 56px;
    background: #ffffff;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--brand-border);
  }

  .emergency-icon {
    background: #fff4f2;
    border-color: #ffd8d1;
  }

  .icon-emoji {
    font-size: 1.75rem;
  }

  .portal-card-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--brand-main);
    margin-bottom: 0.65rem;
  }

  .portal-card-desc {
    font-size: 0.925rem;
    color: var(--brand-secondary);
    line-height: 1.55;
    margin-bottom: 1.5rem;
    flex-grow: 1;
  }

  .portal-card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--brand-primary);
  }

  .emergency-link {
    color: #c93b2b;
  }

  .portal-card:hover .portal-card-link {
    transform: translateX(4px);
  }
</style>
