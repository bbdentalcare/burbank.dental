---
// Header.astro
import { Image } from 'astro:assets';
import logoImg from '../assets/images/logo.avif';
---

<!-- Top Announcement Bar -->
<div class="top-bar">
  <div class="container top-bar-content">
    <div class="top-bar-left">
      <span class="pulse-dot"></span>
      <span>Now Welcoming New Patients in Burbank, CA</span>
    </div>
    <div class="top-bar-right">
      <a href="tel:8182563060" class="top-bar-link">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
        <span>(818) 256-3060</span>
      </a>
      <span class="divider">|</span>
      <span class="hours">Tue–Sat: 8am–5pm</span>
    </div>
  </div>
</div>

<!-- Main Sticky Header -->
<header class="site-header" id="site-header">
  <div class="container header-container">
    <!-- Brand Logo -->
    <a href="https://bbdentalcare.com" class="brand-logo">
      <Image src={logoImg} alt="BB Dental Care Logo" width={180} height={44} class="logo-img" loading="eager" />
      <span class="domain-tag">Burbank</span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Main Navigation">
      <a href="#portal" class="nav-link">Offers</a>
      <a href="#services" class="nav-link">Services</a>
      <a href="#amenities" class="nav-link">Amenities</a>
      <a href="#doctor" class="nav-link">Dr. Bryanna</a>
      <a href="#testimonials" class="nav-link">Reviews</a>
      <a href="#location" class="nav-link">Location</a>
      <a href="https://bbdentalcare.com" target="_blank" rel="noopener noreferrer" class="nav-link external-badge">
        <span>Main Site</span>
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
          <polyline points="15 3 21 3 21 9"></polyline>
          <line x1="10" y1="14" x2="21" y2="3"></line>
        </svg>
      </a>
    </nav>

    <!-- Header Action CTAs -->
    <div class="header-actions">
      <a href="tel:8182563060" class="btn btn-light btn-sm phone-btn" aria-label="Call (818) 256-3060">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
        <span>Call</span>
      </a>

      <a href="https://appointments.bbdentalcare.com" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm book-btn">
        <span>Book Online</span>
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button class="mobile-toggle" id="mobile-toggle" aria-label="Toggle navigation menu" aria-expanded="false">
        <span class="bar bar-1"></span>
        <span class="bar bar-2"></span>
        <span class="bar bar-3"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div class="mobile-menu" id="mobile-menu">
    <div class="container mobile-menu-inner">
      <a href="#portal" class="mobile-nav-link">
        <span>New Patient Offers</span>
        <span class="arrow">›</span>
      </a>
      <a href="#services" class="mobile-nav-link">
        <span>Dental & Aesthetic Services</span>
        <span class="arrow">›</span>
      </a>
      <a href="#amenities" class="mobile-nav-link">
        <span>Spa Amenities & Comforts</span>
        <span class="arrow">›</span>
      </a>
      <a href="#doctor" class="mobile-nav-link">
        <span>Meet Dr. Bryanna Hubbard, DDS</span>
        <span class="arrow">›</span>
      </a>
      <a href="#testimonials" class="mobile-nav-link">
        <span>Patient Testimonials</span>
        <span class="arrow">›</span>
      </a>
      <a href="#insurance" class="mobile-nav-link">
        <span>Insurance & Plans</span>
        <span class="arrow">›</span>
      </a>
      <a href="#location" class="mobile-nav-link">
        <span>Location & Hours</span>
        <span class="arrow">›</span>
      </a>
      <a href="https://bbdentalcare.com" target="_blank" rel="noopener noreferrer" class="mobile-nav-link highlight">
        <span>Visit Official bbdentalcare.com ↗</span>
      </a>
      
      <div class="mobile-cta-group">
        <a href="https://appointments.bbdentalcare.com" target="_blank" rel="noopener noreferrer" class="btn btn-primary w-full">
          Book Appointment Online
        </a>
        <a href="tel:8182563060" class="btn btn-light w-full">
          Call (818) 256-3060
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .top-bar {
    background-color: var(--brand-main);
    color: #ffffff;
    font-size: 0.8rem;
    padding: 0.4rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .top-bar-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .top-bar-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    background-color: var(--brand-accent);
    border-radius: 50%;
    box-shadow: 0 0 0 rgba(146, 216, 216, 0.4);
    animation: pulse 2s infinite;
    flex-shrink: 0;
  }

  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(146, 216, 216, 0.7); }
    70% { box-shadow: 0 0 0 6px rgba(146, 216, 216, 0); }
    100% { box-shadow: 0 0 0 0 rgba(146, 216, 216, 0); }
  }

  .top-bar-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: rgba(255, 255, 255, 0.85);
    flex-shrink: 0;
  }

  .top-bar-link {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--brand-accent);
    font-weight: 600;
  }

  .top-bar-link:hover {
    color: #ffffff;
  }

  .divider {
    opacity: 0.3;
  }

  /* Site Header */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(245, 244, 241, 0.96);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--brand-border);
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 68px;
    gap: 1rem;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .logo-img {
    height: 34px;
    width: auto;
    object-fit: contain;
  }

  .domain-tag {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background-color: var(--brand-primary);
    color: #ffffff;
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-sm);
    line-height: 1;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 1.15rem;
    flex-shrink: 0;
  }

  .nav-link {
    font-size: 0.885rem;
    font-weight: 600;
    color: var(--brand-secondary);
    position: relative;
    padding: 0.2rem 0;
    white-space: nowrap;
  }

  .nav-link:hover {
    color: var(--brand-primary);
  }

  .external-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--brand-primary);
    background: var(--brand-primary-light);
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--brand-accent-soft);
    font-size: 0.785rem;
    font-weight: 700;
  }

  .external-badge:hover {
    background: var(--brand-primary);
    color: #ffffff;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .btn-sm {
    padding: 0.5rem 1rem;
    font-size: 0.85rem;
  }

  /* Hamburger Toggle */
  .mobile-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    background: transparent;
    border: 1px solid var(--brand-border);
    border-radius: var(--radius-sm);
    cursor: pointer;
    padding: 8px;
    transition: all 0.2s ease;
  }

  .mobile-toggle:hover {
    background: #ffffff;
    border-color: var(--brand-accent);
  }

  .mobile-toggle .bar {
    display: block;
    height: 2px;
    width: 20px;
    background-color: var(--brand-main);
    border-radius: 2px;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .mobile-toggle.is-open .bar-1 {
    transform: translateY(7px) rotate(45deg);
  }

  .mobile-toggle.is-open .bar-2 {
    opacity: 0;
  }

  .mobile-toggle.is-open .bar-3 {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile Menu Dropdown */
  .mobile-menu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background-color: #ffffff;
    border-bottom: 1px solid var(--brand-border);
    box-shadow: 0 16px 32px rgba(15, 28, 28, 0.12);
    padding: 1rem 0 1.5rem;
  }

  .mobile-menu.active {
    display: block;
    animation: slideDown 0.25s ease forwards;
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .mobile-menu-inner {
    display: flex;
    flex-direction: column;
  }

  .mobile-nav-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.975rem;
    font-weight: 600;
    color: var(--brand-main);
    padding: 0.75rem 0.5rem;
    border-bottom: 1px solid var(--brand-border);
    border-radius: var(--radius-sm);
    transition: background 0.15s ease, color 0.15s ease;
  }

  .mobile-nav-link:hover {
    background: var(--brand-bg);
    color: var(--brand-primary);
  }

  .mobile-nav-link .arrow {
    color: var(--brand-muted);
    font-size: 1.25rem;
    line-height: 1;
  }

  .mobile-nav-link.highlight {
    color: var(--brand-primary);
    font-weight: 700;
    background: var(--brand-primary-light);
    margin-top: 0.5rem;
    padding: 0.75rem 0.75rem;
    border: 1px solid var(--brand-accent-soft);
  }

  .mobile-cta-group {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    margin-top: 1rem;
    padding-top: 0.5rem;
  }

  .w-full {
    width: 100%;
  }

  @media (max-width: 1040px) {
    .desktop-nav {
      display: none;
    }

    .mobile-toggle {
      display: flex;
    }
  }

  @media (max-width: 600px) {
    .top-bar-right .hours,
    .top-bar-right .divider {
      display: none;
    }

    .phone-btn {
      display: none;
    }

    .logo-img {
      height: 30px;
    }
  }
</style>

<script>
  function setupNav() {
    const toggleBtn = document.getElementById('mobile-toggle');
    const menu = document.getElementById('mobile-menu');

    if (toggleBtn && menu) {
      toggleBtn.addEventListener('click', () => {
        const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
        toggleBtn.setAttribute('aria-expanded', (!isExpanded).toString());
        toggleBtn.classList.toggle('is-open');
        menu.classList.toggle('active');
      });

      // Close menu when clicking nav items
      const links = menu.querySelectorAll('a');
      links.forEach(link => {
        link.addEventListener('click', () => {
          menu.classList.remove('active');
          toggleBtn.classList.remove('is-open');
          toggleBtn.setAttribute('aria-expanded', 'false');
        });
      });
    }
  }

  setupNav();
  document.addEventListener('astro:page-load', setupNav);
</script>
