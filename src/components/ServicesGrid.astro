---
// ServicesGrid.astro
const services = [
  {
    title: "General & Family Dentistry",
    desc: "Routine cleanings, digital check-ups, dental sealants, fluoride treatments, and gentle care for all ages from toddlers to seniors.",
    link: "https://bbdentalcare.com/services/category/general-dentistry/",
    icon: "🦷",
    tag: "Preventative"
  },
  {
    title: "Cosmetic Dentistry",
    desc: "Custom porcelain veneers, professional teeth whitening, cosmetic bonding, and smile makeovers designed to boost your confidence.",
    link: "https://bbdentalcare.com/services/category/cosmetic-dentistry/",
    icon: "✨",
    tag: "Aesthetics"
  },
  {
    title: "Dental Implants & Restorations",
    desc: "Permanent tooth replacements, single implants, full-mouth reconstructions (All-on-4 / All-on-6), crowns, and fixed bridges.",
    link: "https://bbdentalcare.com/services/category/implant-dentistry/",
    icon: "🔩",
    tag: "Permanent"
  },
  {
    title: "Emergency Dentistry",
    desc: "Urgent care for sudden toothaches, broken teeth, knocked-out teeth, lost fillings, and dental infections. Prompt same-day relief.",
    link: "https://bbdentalcare.com/services/category/emergency-dentistry/",
    icon: "🚨",
    tag: "Same-Day"
  },
  {
    title: "Holistic & Biocompatible Dentistry",
    desc: "Mercury-safe, fluoride-conscious, science-based biological dentistry honoring your whole-body health and wellness.",
    link: "https://bbdentalcare.com/services/category/holistic-dentistry/",
    icon: "🌿",
    tag: "Wellness"
  },
  {
    title: "Facial Aesthetics & MedSpa",
    desc: "Botox treatments, facial fillers, microneedling therapies, lymphatic drainage, radiofrequency, and skin revitalization in-office.",
    link: "https://bbdentalcare.com/services/category/cosmetic-dentistry/",
    icon: "💆‍♀️",
    tag: "Beauty"
  },
  {
    title: "Pediatric Dentistry",
    desc: "Warm, gentle care creating anxiety-free, positive dental experiences for infants, children, and teenagers.",
    link: "https://bbdentalcare.com/services/category/pediatric-dentistry/",
    icon: "🧸",
    tag: "Family"
  },
  {
    title: "Periodontics & Gum Therapy",
    desc: "Deep cleanings, periodontal maintenance, bone grafting, and gentle gingival surgery to protect your smile foundation.",
    link: "https://bbdentalcare.com/services/category/periodontics/",
    icon: "🛡️",
    tag: "Gum Health"
  },
  {
    title: "Minor Oral Surgery",
    desc: "Comfortable wisdom teeth extractions, simple surgical removals, and pre-prosthetic procedures with gentle sedation options.",
    link: "https://bbdentalcare.com/services/category/minor-oral-surgery/",
    icon: "⚕️",
    tag: "Surgical"
  }
];
---

<section class="services-section section" id="services">
  <div class="container">
    <div class="section-header">
      <span class="badge badge-primary">Comprehensive Treatments</span>
      <h2 class="section-title">
        Full-Scope Dental Care <span class="text-gradient">Under One Roof</span>
      </h2>
      <p class="section-subtitle">
        From routine family checkups and biological dentistry to advanced dental implants and facial aesthetics, we provide personalized care tailored to your unique smile goals.
      </p>
    </div>

    <div class="services-grid">
      {services.map((service) => (
        <a href={service.link} target="_blank" rel="noopener noreferrer" class="service-card">
          <div class="card-top">
            <div class="service-icon-box">
              <span class="service-emoji">{service.icon}</span>
            </div>
            <span class="service-tag">{service.tag}</span>
          </div>

          <h3 class="service-title">{service.title}</h3>
          <p class="service-desc">{service.desc}</p>

          <div class="service-cta">
            <span>Learn More on bbdentalcare.com</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14"></path>
              <path d="M12 5l7 7-7 7"></path>
            </svg>
          </div>
        </a>
      ))}
    </div>

    <div class="services-bottom-cta">
      <div class="cta-inner">
        <div>
          <h3 class="cta-heading">Ready to schedule your visit?</h3>
          <p class="cta-sub">Book in seconds online or call our Burbank dental team today.</p>
        </div>
        <div class="cta-btn-group">
          <a href="https://appointments.bbdentalcare.com" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">Book Online</a>
          <a href="tel:8182563060" class="btn btn-secondary btn-lg">Call (818) 256-3060</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .services-section {
    background-color: var(--brand-bg);
  }

  .section-header {
    text-align: center;
    max-width: 780px;
    margin: 0 auto 3.5rem;
  }

  .section-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 800;
    color: var(--brand-main);
    margin: 0.85rem 0 1rem;
    line-height: 1.2;
  }

  .section-subtitle {
    font-size: 1.1rem;
    color: var(--brand-secondary);
    line-height: 1.6;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1.75rem;
    margin-bottom: 3.5rem;
  }

  .service-card {
    background: var(--brand-bg-white);
    border: 1px solid var(--brand-border);
    border-radius: var(--radius-lg);
    padding: 2.25rem 2rem;
    display: flex;
    flex-direction: column;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    box-shadow: var(--shadow-sm);
  }

  .service-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-hover);
    border-color: var(--brand-accent);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }

  .service-icon-box {
    width: 48px;
    height: 48px;
    background: var(--brand-primary-light);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--brand-accent-soft);
  }

  .service-emoji {
    font-size: 1.5rem;
  }

  .service-tag {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--brand-primary);
    background: var(--brand-bg);
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
  }

  .service-title {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--brand-main);
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }

  .service-desc {
    font-size: 0.95rem;
    color: var(--brand-secondary);
    line-height: 1.6;
    margin-bottom: 1.75rem;
    flex-grow: 1;
  }

  .service-cta {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--brand-primary);
    transition: transform 0.2s ease;
  }

  .service-card:hover .service-cta {
    transform: translateX(4px);
  }

  /* Bottom CTA box */
  .services-bottom-cta {
    background: linear-gradient(135deg, #0F1C1C 0%, #1e3535 100%);
    color: #ffffff;
    border-radius: var(--radius-lg);
    padding: 2.75rem 3rem;
    box-shadow: var(--shadow-lg);
  }

  .cta-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 2rem;
  }

  .cta-heading {
    font-size: 1.75rem;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 0.35rem;
  }

  .cta-sub {
    font-size: 1.05rem;
    color: var(--brand-accent-soft);
  }

  .cta-btn-group {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .cta-btn-group .btn-secondary {
    color: #ffffff;
    border-color: var(--brand-accent);
  }

  .cta-btn-group .btn-secondary:hover {
    background: var(--brand-accent);
    color: var(--brand-main);
  }

  @media (max-width: 768px) {
    .services-grid {
      grid-template-columns: 1fr;
    }
    .services-bottom-cta {
      padding: 2rem 1.5rem;
    }
    .cta-inner {
      flex-direction: column;
      align-items: flex-start;
    }
    .cta-btn-group {
      width: 100%;
    }
    .cta-btn-group .btn {
      width: 100%;
    }
  }
</style>
