---
// Testimonials.astro
const reviews = [
  {
    author: "Tatiana de Paula Kasputis",
    role: "Verified Patient",
    text: "Dr. Bryanna was the only one really willing to fix my teeth problems and find a long term solution! She is a very caring and loving person with her patients and extremely professional! I recommend her to everyone I know!",
    rating: 5
  },
  {
    author: "Carlos Esquivia",
    role: "Verified Patient",
    text: "Excellent dentist always makes my yearly visits fun and works around my work schedule. When I had some work done, she made sure I was comfortable, Dr. Bryanna is the best! This is the place if you want an Amazing dentist!",
    rating: 5
  },
  {
    author: "Vick Zazueta",
    role: "Verified Patient",
    text: "…A Gem in dentistry, blessing all the teeth that are lucky enough to get treated by her. The staff is so welcoming and the office feels like a luxury retreat.",
    rating: 5
  },
  {
    author: "Sara P.",
    role: "Family Patient",
    text: "I highly highly highly recommend Bryanna for your dental work and your kids. She made my children feel so relaxed and happy to visit the dentist!",
    rating: 5
  }
];
---

<section class="testimonials-section section" id="testimonials">
  <div class="container">
    <div class="section-header">
      <div class="rating-pill">
        <span class="stars">★★★★★</span>
        <span class="rating-text">5.0 Star Rating on Google & Yelp</span>
      </div>
      <h2 class="section-title">
        Loved by Patients Across <span class="text-gradient">Burbank & Beyond</span>
      </h2>
      <p class="section-subtitle">
        We are honored to care for our community. Read firsthand experiences from patients who trust BB Dental Care with their smiles.
      </p>
    </div>

    <div class="reviews-grid">
      {reviews.map((rev) => (
        <div class="review-card">
          <div class="stars-row">
            {"★".repeat(rev.rating)}
          </div>
          <p class="review-text">"{rev.text}"</p>
          <div class="reviewer-meta">
            <div class="avatar-initial">
              {rev.author.charAt(0)}
            </div>
            <div>
              <p class="reviewer-name"><strong>{rev.author}</strong></p>
              <span class="reviewer-role">{rev.role}</span>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="testimonials-footer">
      <a href="https://bbdentalcare.com/testimonials/" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-lg">
        <span>Read All Reviews on bbdentalcare.com</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M5 12h14"></path>
          <path d="M12 5l7 7-7 7"></path>
        </svg>
      </a>
      <a href="https://www.yelp.com/biz/bb-dental-care-burbank" target="_blank" rel="noopener noreferrer" class="yelp-link">
        <span>Check our Yelp Reviews ↗</span>
      </a>
    </div>
  </div>
</section>

<style>
  .testimonials-section {
    background: #ffffff;
    border-top: 1px solid var(--brand-border);
    border-bottom: 1px solid var(--brand-border);
  }

  .section-header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 3.5rem;
  }

  .rating-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #fff8eb;
    border: 1px solid #ffd88a;
    padding: 0.35rem 0.95rem;
    border-radius: var(--radius-full);
    margin-bottom: 1rem;
  }

  .stars {
    color: var(--brand-gold);
    letter-spacing: 2px;
    font-size: 1rem;
  }

  .rating-text {
    font-size: 0.85rem;
    font-weight: 700;
    color: #8f5800;
  }

  .section-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 800;
    color: var(--brand-main);
    margin-bottom: 0.85rem;
    line-height: 1.2;
  }

  .section-subtitle {
    font-size: 1.1rem;
    color: var(--brand-secondary);
    line-height: 1.6;
  }

  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.75rem;
    margin-bottom: 3rem;
  }

  .review-card {
    background: var(--brand-bg);
    border: 1px solid var(--brand-border);
    border-radius: var(--radius-lg);
    padding: 2.25rem 2rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.3s ease;
  }

  .review-card:hover {
    transform: translateY(-4px);
    border-color: var(--brand-accent);
    box-shadow: var(--shadow-md);
    background: #ffffff;
  }

  .stars-row {
    color: var(--brand-gold);
    font-size: 1.1rem;
    margin-bottom: 1rem;
    letter-spacing: 2px;
  }

  .review-text {
    font-size: 0.975rem;
    color: var(--brand-secondary);
    line-height: 1.65;
    font-style: italic;
    margin-bottom: 1.75rem;
  }

  .reviewer-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .avatar-initial {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--brand-primary);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1.05rem;
  }

  .reviewer-name {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--brand-main);
    line-height: 1.2;
  }

  .reviewer-role {
    font-size: 0.8rem;
    color: var(--brand-muted);
  }

  .testimonials-footer {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .yelp-link {
    font-size: 0.95rem;
    font-weight: 700;
    color: #c41200;
  }

  .yelp-link:hover {
    text-decoration: underline;
  }
</style>
