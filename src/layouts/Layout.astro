---
import Seo from '@jdevalk/astro-seo-graph/Seo.astro';
import { getSeoGraph } from '../utils/schema';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
}

const {
  title = "Burbank Dental | BB Dental Care",
  description = "Looking for a top-rated dentist in Burbank? BB Dental Care offers family, cosmetic, implant, emergency, and holistic dentistry at 916 W Burbank Blvd. Book online today!",
  canonicalUrl = "https://burbank.dental/",
} = Astro.props;

const graph = getSeoGraph(canonicalUrl);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <Seo
      title={title}
      description={description}
      canonical={canonicalUrl}
      ogType="website"
      ogImage="https://bbdentalcare.com/wp-content/uploads/2025/06/hero-1024x526.avif"
      ogImageAlt="BB Dental Care Burbank"
      ogImageWidth={1024}
      ogImageHeight={526}
      siteName="BB Dental Care"
      locale="en_US"
      twitter={{
        card: "summary_large_image",
        site: "@drabryannadds",
        creator: "@drabryannadds"
      }}
      graph={graph}
    />

    <!-- Fonts preconnect & stylesheet -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
  </body>
</html>
