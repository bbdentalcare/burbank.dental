---
interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
}

const {
  title = "Burbank Dental | BB Dental Care",
  description = "Looking for a top-rated dentist in Burbank? BB Dental Care offers family, cosmetic, implant, emergency, and holistic dentistry at 916 W Burbank Blvd. Book online today!",
  canonicalUrl = "https://burbank.dental",
} = Astro.props;

const businessSchema = {
  "@context": "https://schema.org",
  "@type": "Dentist",
  "name": "BB Dental Care",
  "image": "https://bbdentalcare.com/wp-content/uploads/2025/05/logo-1024x251.avif",
  "@id": "https://bbdentalcare.com",
  "url": "https://bbdentalcare.com",
  "telephone": "+18182563060",
  "priceRange": "$$",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "916 W Burbank Blvd. Suite A",
    "addressLocality": "Burbank",
    "addressRegion": "CA",
    "postalCode": "91506",
    "addressCountry": "US"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 34.1836092,
    "longitude": -118.3223941
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
      "opens": "08:00",
      "closes": "17:00"
    }
  ],
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5.0",
    "reviewCount": "120"
  },
  "sameAs": [
    "https://bbdentalcare.com",
    "https://share.bbdentalcare.com/instagram",
    "https://share.bbdentalcare.com/facebook",
    "https://www.yelp.com/biz/bb-dental-care-burbank"
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://burbank.dental" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://bbdentalcare.com/wp-content/uploads/2025/06/hero-1024x526.avif" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://bbdentalcare.com/wp-content/uploads/2025/06/hero-1024x526.avif" />

    <!-- Fonts preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
  </head>
  <body>
    <slot />
  </body>
</html>
